# Postgres connection string for the Notary Check engine.
# Copy this file to .env and adjust for your local Postgres.
DATABASE_URL=postgres://localhost:5432/notary_check

# API key for the DeepSeek judge (§ LLM judge design). Only needed when the
# semantic-evaluator path actually runs; the deterministic verifier, the mocked
# judge tests, and the build never require it. Never commit a real key.
DEEPSEEK_API_KEY=sk-your-deepseek-key
