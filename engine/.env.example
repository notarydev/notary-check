# Postgres connection string for the Notary Check engine.
# Copy this file to .env and adjust for your local Postgres.
DATABASE_URL=postgres://localhost:5432/notary_check

# API key for the DeepSeek judge (§ LLM judge design). Only needed when the
# semantic-evaluator path actually runs; the deterministic verifier, the mocked
# judge tests, and the build never require it. Never commit a real key.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# --- Build-order step 5 (auth, quotas, retention, observability, kill switch) ---

# Monthly spend limit per organization, in US cents. The sum of the current
# calendar month's usage_event.estimated_cost_cents for an org is compared
# against this; at or above it, the org's expensive work is denied.
# Default 100000 = $1,000/month/org.
NOTARY_ORG_MONTHLY_LIMIT_CENTS=100000

# Hard global DeepSeek spend cap, in US cents, across ALL organizations for the
# current calendar month. A separate ceiling from the per-org limit: many orgs
# each under their own limit can still exceed total provider spend together.
# Default 500000 = $5,000/month.
NOTARY_GLOBAL_SPEND_CAP_CENTS=500000

# Kill switch for the semantic-evaluator (judge) path. Set to "true" or "1" to
# disable the judge: extractField() then returns cannot_be_determined for every
# field WITHOUT calling the judge at all (no network). Deterministic checks are
# completely unaffected. Default false (judge enabled).
NOTARY_JUDGE_KILL_SWITCH=false

# --- Billing scaffolding (Stripe) ---

# Stripe secret key. A live TEST-MODE key is already configured in engine/.env
# (gitignored). Never commit a real key. The engine boots fail-fast when this
# is missing (the billing routes cannot be configured without it).
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe publishable key (for the future self-serve checkout UI, not read by
# the engine yet). Never commit a real key.
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Stripe webhook signing secret (Stripe-Signature header verification for
# POST /v1/billing/webhook). PLACEHOLDER ONLY — a real value comes from
# `stripe listen` or a live endpoint secret; generating one is a known follow-up
# (needs the webhook endpoint to exist). Until this is set, the webhook route
# returns 500 (it cannot verify signatures), which is safe: no event is applied.
# Never commit a real value.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-placeholder

# Where Stripe Checkout redirects the buyer after a session.
NOTARY_BILLING_SUCCESS_URL=http://localhost:3000/billing/success
NOTARY_BILLING_CANCEL_URL=http://localhost:3000/billing/cancel

# --- Internal service auth (Clerk → organization resolution) ---

# Shared secret between THIS engine and server/ (the MCP layer) only — never
# exposed to end users, never presented over any user-facing surface. Required
# by POST /v1/internal/resolve-organization (checked via the X-Internal-Secret
# header, compared with node:crypto's timingSafeEqual, never `===`). This is
# a DIFFERENT mechanism from the per-organization API keys in
# organization_api_key: this endpoint is what PROVISIONS an organization/key
# for a Clerk-authenticated user, so it can't itself be gated by that scheme.
# Generate a real high-entropy value for any shared environment, e.g.
# `openssl rand -hex 32`. Never commit a real value.
INTERNAL_SERVICE_SECRET=change-me-to-a-long-random-shared-secret
