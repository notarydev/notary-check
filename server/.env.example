# Engine (notary-check's HTTP API)
ENGINE_URL=http://localhost:4001
# Fallback API key used only when no per-user Clerk-resolved key is available
# (e.g. local/manual testing without Clerk configured). The real
# Clerk-authenticated path always resolves and uses each user's own key.
ENGINE_API_KEY=

# Shared secret with the engine's internal resolve-organization endpoint.
# Not a per-user credential — do not put a real value here, wired at deploy
# time.
INTERNAL_SERVICE_SECRET=

# Clerk — same Clerk application already used by dashboard/. Do not put real
# secrets here; wired at deploy time.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
