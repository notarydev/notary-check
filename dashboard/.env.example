# Clerk (see .env.local for the real values)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the notary-check engine API (engine/), used server-side only by
# dashboard/src/lib/engine.ts. Never exposed to the browser.
ENGINE_URL=http://localhost:4000

# Shared secret sent as the X-Internal-Secret header on the engine's internal
# lazy-provisioning endpoint (POST /v1/internal/resolve-organization), which
# maps the signed-in Clerk user to their Notary organization. Must match the
# engine's own internal-secret env var. Server-side only, never exposed to
# the browser.
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret

# The public signup gate. Defaults to "waitlist" (email capture only, no
# account creation) if unset or anything other than exactly "open" — this is
# deliberate: public self-serve signup/payment is blocked by the canonical
# build plan until the held-out eval gate passes (see
# docs/build/architecture-and-progress.md). Flipping to "open" only affects
# this app's own landing page; Clerk's own Restricted sign-up mode (set in
# the Clerk dashboard, not here) must ALSO be turned off for signup to
# actually work end to end — a deliberate two-part switch, not one flag.
NOTARY_SIGNUP_MODE=waitlist

# Public URL of the Notary MCP connector that users add to Claude (Settings →
# Connectors → Add custom connector), shown on /dashboard/settings/connect.
# Read server-side with a placeholder fallback if unset — do NOT hardcode the
# production URL here, this is dev-time config.
NOTARY_MCP_CONNECTOR_URL=https://mcp.example.com
